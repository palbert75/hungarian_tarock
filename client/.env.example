# Server URL
# Default: http://localhost:8000
VITE_SERVER_URL=http://localhost:8000

# Enable development tools (optional)
# VITE_ENABLE_DEV_TOOLS=true

# Analytics ID (optional, for production)
# VITE_ANALYTICS_ID=

# Donation link (optional). A payment link or donation page; the "Support the game"
# button is shown only when this is set.
# VITE_DONATE_URL=https://example.com/donate
